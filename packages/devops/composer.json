{
    "name": "witify/devops",
    "description": "Health endpoint that reports the state of a Laravel application to the Witify portal.",
    "keywords": ["laravel", "health", "devops", "witify"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Witify",
            "email": "info@witify.io"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/contracts": "^8.75|^9.0|^10.0|^11.0|^12.0",
        "illuminate/database": "^8.75|^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^8.75|^9.0|^10.0|^11.0|^12.0",
        "illuminate/routing": "^8.75|^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^8.75|^9.0|^10.0|^11.0|^12.0",
        "spatie/cpu-load-health-check": "^1.0",
        "spatie/laravel-health": "^1.34"
    },
    "require-dev": {
        "orchestra/testbench": "^6.23|^7.6|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.5|^10.5|^11.0"
    },
    "suggest": {
        "spatie/laravel-backup": "Reports the backup destination in the health payload."
    },
    "autoload": {
        "psr-4": {
            "Witify\\Devops\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Witify\\Devops\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Witify\\Devops\\DevopsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
