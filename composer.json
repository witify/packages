{
    "name": "witify/packages",
    "description": "Monorepo of the Witify Composer packages. Each packages/* directory is split into its own read-only repository.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "larastan/larastan": "^3.8",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "witify/devops": "@dev",
        "witify/notifications": "@dev",
        "witify/support": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "witify/devops": "1.3.0",
                    "witify/support": "1.3.0",
                    "witify/notifications": "1.3.0"
                }
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Witify\\Devops\\Tests\\": "packages/devops/tests/",
            "Witify\\Support\\Tests\\": "packages/support/tests/",
            "Witify\\Notifications\\Tests\\": "packages/notifications/tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G && phpstan analyse --memory-limit=1G -c packages/support/phpstan.neon && phpstan analyse --memory-limit=1G -c packages/notifications/phpstan.neon"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
